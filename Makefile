CXX      ?= g++
CXXFLAGS ?= -std=c++20 -O2 -Wall -Wextra
LDLIBS   += -lsfml-audio -lsfml-graphics -lsfml-window -lsfml-system

ifeq ($(shell uname -s),Darwin)
SFML     ?= /opt/homebrew
CPPFLAGS += -DGL_SILENCE_DEPRECATION
LDLIBS   += -framework OpenGL
else
SFML     ?= /usr/local
LDLIBS   += -lGL
endif

CPPFLAGS += -DGL_GLEXT_PROTOTYPES -I$(SFML)/include
LDFLAGS  += -L$(SFML)/lib -Wl,-rpath,$(SFML)/lib

.DEFAULT_GOAL := all

# the engines: every engines/<type>/engine.mk adds its mesh rules, its meshes to MESHES and the header
# that registers it (REGISTER_ENGINE) to ENGINE_HEADERS. Folders whose name starts with _ (the
# template) are skipped. Adding an engine needs no edit here.
MESHES =
ENGINE_HEADERS =
ENGINE_MKS := $(sort $(filter-out engines/_%,$(wildcard engines/*/engine.mk)))
-include $(ENGINE_MKS)

# one translation unit: engine_sim.cpp includes src/ and, through engines/all.hpp, the engines
HEADERS = $(wildcard src/*.hpp) $(filter-out engines/_%,$(wildcard engines/*/*.hpp)) engines/all.hpp

all: engine_sim $(MESHES)

engine_sim: engine_sim.cpp $(HEADERS)
	$(CXX) $(CXXFLAGS) $(CPPFLAGS) $< -o $@ $(LDFLAGS) $(LDLIBS)

# engines/all.hpp includes every engine's header. Rewritten only when the list changes, so the
# binary is not rebuilt for nothing
engines/all.hpp: FORCE
	@{ echo "// generated by the Makefile from the engines' engine.mk files (ENGINE_HEADERS): do not edit"; \
	   echo "#pragma once"; \
	   for h in $(ENGINE_HEADERS); do echo "#include \"$${h#engines/}\""; done; } >$@.tmp
	@if cmp -s $@.tmp $@; then rm -f $@.tmp; else mv $@.tmp $@; echo "wrote $@"; fi

# make run (the inline-4), make run ENGINE=<id or alias>, or make run-<id or alias>
ENGINE ?= inline4
run: all
	./engine_sim --engine-type $(ENGINE)

run-%: all
	./engine_sim --engine-type $*

# kinematics and physics checks for every engine and version of one (--engine-type list --ids: the
# engine itself gets --selftest and --phystest, its versions --phystest), plus synthetic inline engines
# of these cylinder counts built in memory (--synthtest N). Every check runs; make fails if any of
# them did (each run's exit status, not just its last line, which is all that is printed)
SYNTH_CYLINDERS = 1 2 3 4 5 6 8
test: all
	@ids=$$(./engine_sim --engine-type list --ids) || exit 1; \
	printf '%s\n' "$$ids" | { \
	fail=0; \
	check() { name=$$1; kind=$$2; shift 2; printf "%-20s %s " "$$name" "$$kind"; \
		out=$$(./engine_sim "$$@" </dev/null); rc=$$?; printf '%s\n' "$$out" | tail -1; \
		if [ $$rc -ne 0 ]; then fail=1; fi; }; \
	while read -r id extra; do \
		if [ -z "$$extra" ]; then check "$$id" selftest --engine-type "$$id" --selftest; fi; \
		check "$$id $$extra" phystest --engine-type "$$id" $$extra --phystest; \
	done; \
	for n in $(SYNTH_CYLINDERS); do check "$$n cyl" synthtest --synthtest $$n; done; \
	if [ $$fail -ne 0 ]; then echo "make test: a check FAILED (see above)"; fi; \
	exit $$fail; }

clean:
	rm -f engine_sim

.PHONY: all run test clean FORCE

assets:
	python3 -I scripts/fetch_assets.py

.PHONY: assets
